# .env.example — template file: iska copy banao aur naam .env rakh do, phir values bharo.
# Ye file commit hoti hai; asli .env KABHI commit nahi hoti (.gitignore me hai).
# Tum (.env) khud bharoge — agent is file ka content nahi dekhega.

GROQ_API_KEY=
GEMINI_API_KEY=

# INSTITUTE_LIVE_ON_PERSONAL=false — personal channel par institute replies LIVE
#   post karne ka MANUAL switch. True karne se bhi post tabhi hoga jab MODE=auto
#   AUR bot --live flag ke saath chal raha ho. Default false = institute replies
#   personal channel par hamesha draft me save hongi (purana safe rule).
INSTITUTE_LIVE_ON_PERSONAL=false
